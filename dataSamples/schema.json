{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/archdraft-flowdraft/contracts/graph.schema.v2.json",
  "title": "ArchDraft x FlowDraft Unified Graph",
  "description": "Canonical property graph for architectural floor plans AND MEP P&ID/SLD. M1 (vision) writes it; M2 (3D), M3 (PUE/BEC), M4 (what-if), M5 (finance) read it. CONVENTION: all 2D coordinates normalized 0-1 relative to source image.",
  "type": "object",
  "required": ["meta", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["diagram_id", "diagram_type", "source_file", "parse_confidence"],
      "additionalProperties": false,
      "properties": {
        "diagram_id": { "type": "string", "minLength": 1 },
        "diagram_type": {
          "type": "string",
          "enum": ["FLOORPLAN", "PID", "SLD", "FUSED"],
          "description": "FLOORPLAN=arch only; PID/SLD=MEP; FUSED=rooms+equipment"
        },
        "building_id": {
          "type": ["string", "null"],
          "description": "CSDI BuildingCSUID when anchored (M6)"
        },
        "source_file": { "type": "string", "minLength": 1 },
        "image_width": { "type": ["integer", "null"], "minimum": 1 },
        "image_height": { "type": ["integer", "null"], "minimum": 1 },
        "parse_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "topology": { "type": "string" },
        "parser": {
          "type": "string",
          "enum": ["claude", "yolo", "floorplan-cv"],
          "description": "Which parser produced this graph"
        },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "pue": {
          "type": "number",
          "minimum": 1.0,
          "description": "Power Usage Effectiveness = facility_power / IT_power"
        },
        "it_power_kW": { "type": "number", "minimum": 0 },
        "facility_power_kW": { "type": "number", "minimum": 0 },
        "target_pue": { "type": "number", "minimum": 1.0 }
      }
    },
    "spaces": {
      "type": "array",
      "description": "Architectural rooms from floor-plan parse",
      "items": { "$ref": "#/$defs/space" }
    },
    "walls": {
      "type": "array",
      "description": "Wall centerlines from floor-plan parse (optional)",
      "items": { "$ref": "#/$defs/wall" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "capacity": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["RT", "kW", "L/s", "CMH", "kVA", "A", "kW_IT"] }
      }
    },
    "efficiency": {
      "type": "object",
      "required": ["metric", "value"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string", "enum": ["COP", "IPLV", "kW/RT", "EER", "PUE"] },
        "value": { "type": "number" }
      }
    },
    "space": {
      "type": "object",
      "required": ["id", "name", "category", "polygon_2d", "area_m2", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["data_hall", "electrical_room", "plant_room", "office", "corridor", "unknown"]
        },
        "polygon_2d": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "area_m2": { "type": "number", "minimum": 0 },
        "floor": { "type": "string" },
        "it_power_kW": {
          "type": "number",
          "minimum": 0,
          "description": "Allocated IT load for PUE denominator in this space"
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "wall": {
      "type": "object",
      "required": ["id", "polyline_2d", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "polyline_2d": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "thickness_mm": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "nodeAttributes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rated_power_kW": { "type": "number", "minimum": 0 },
        "annual_energy_kwh": { "type": "number", "minimum": 0 },
        "capacity": { "$ref": "#/$defs/capacity" },
        "efficiency": { "$ref": "#/$defs/efficiency" },
        "voltage_V": { "type": "number", "minimum": 0 },
        "ampacity_A": { "type": "number", "minimum": 0 },
        "install_year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "manufacturer": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "floor": { "type": "string" },
        "rack_count": { "type": "integer", "minimum": 0 }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "tag", "attributes", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": {
          "type": "string",
          "enum": [
            "chiller", "pump", "cooling_tower", "ahu", "fcu", "boiler", "fan",
            "transformer", "switchgear", "breaker", "distribution_panel", "meter",
            "valve", "sensor", "instrument", "fitting", "unknown",
            "crac", "crah", "ups", "pdu", "busway", "rack"
          ]
        },
        "sub_type": { "type": ["string", "null"] },
        "tag": { "type": "string" },
        "space_id": {
          "type": ["string", "null"],
          "description": "Room this equipment sits in (fusion layer)"
        },
        "attributes": { "$ref": "#/$defs/nodeAttributes" },
        "bbox_2d": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "rotation_deg": { "type": "number" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "edgeAttributes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "diameter_mm": { "type": "number", "minimum": 0 },
        "medium": { "type": "string" },
        "flow_lps": { "type": "number", "minimum": 0 },
        "ampacity_A": { "type": "number", "minimum": 0 },
        "phase": { "type": "integer", "enum": [1, 3] }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "type", "from", "to", "attributes", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": {
          "type": "string",
          "enum": [
            "chw_supply", "chw_return", "condenser_water", "air_duct",
            "electrical_cable", "control_signal", "unknown"
          ]
        },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "attributes": { "$ref": "#/$defs/edgeAttributes" },
        "polyline_2d": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
