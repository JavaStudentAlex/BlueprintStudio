# Copy this file to `.env` and adjust as needed.

# --- Local LLM (Ollama) for rule extraction ---
# Requires a running Ollama server: `ollama serve` and `ollama pull mistral`.
OLLAMA_MODEL=mistral
# Optional: point at a non-default Ollama host (the client reads OLLAMA_HOST).
# OLLAMA_HOST=http://localhost:11434

# Pages per PDF chunk (smaller = safer for context limits, more model calls).
PDF_PAGES_PER_CHUNK=3

# --- PostgreSQL connection ---
# If unreachable, the app falls back to an in-memory SQLite database for the PoC.
DATABASE_URL=postgresql+psycopg2://dc_user:dc_password@localhost:5432/dc_compliance
