# Copy this file to `.env` and adjust as needed.

# --- Claude API (Anthropic) for rule extraction ---
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Pages per PDF chunk (smaller = safer for context limits, more API calls) ---
PDF_PAGES_PER_CHUNK=3

# --- PostgreSQL connection ---
# If unreachable, the app falls back to an in-memory SQLite database.
DATABASE_URL=postgresql+psycopg2://dc_user:dc_password@localhost:5432/dc_compliance
